# ---------------------------------------------------------------------------------------------
# Cove configuration. Copy to .env and adjust. Never commit a real .env.
# Every variable is validated at startup; in production the server refuses to start with
# unsafe values (development secrets, http origin, missing SMTP).
# ---------------------------------------------------------------------------------------------

# development | production | test
NODE_ENV=development
APP_NAME=Cove

# Public URL users open, without a trailing slash. Must be https:// in production.
# It is also the only Origin allowed for API writes and WebSocket connections.
APP_ORIGIN=http://localhost:8080
HOST=0.0.0.0
PORT=8080
# true when exactly one reverse proxy (Caddy/nginx) sits in front and sets X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info

# ---- Database (PostgreSQL 14+) ----
DATABASE_URL=postgres://postgres:devpassword@127.0.0.1:5432/cove_dev
# disable | require | verify-full
DATABASE_SSL=disable
DATABASE_POOL_MAX=10

# ---- Secrets: generate with `npm run secrets:generate` (two different random values) ----
SESSION_SECRET=change-me-to-a-long-random-value-at-least-32-characters
OTP_PEPPER=change-me-to-another-long-random-value-at-least-32-chars

# ---- Email (sign-in codes and security notices) ----
# Local development: `npm run dev` starts a mailbox on 127.0.0.1:1025 that prints emails.
# Production examples:
#   Gmail (app password, ~500 emails/day):  SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true
#   Postmark / Resend / SES / Mailgun:       use their SMTP host, port 587, SMTP_SECURE=false (STARTTLS is required in production)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Refuse to send without TLS. Defaults to true in production when SMTP_SECURE=false.
# SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cove <no-reply@example.com>

# ---- Sign-in policy ----
# Comma-separated list of allowed email domains.
ALLOWED_EMAIL_DOMAINS=gmail.com
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_FAILURES_PER_HOUR=15
# Per client IP (behind a proxy this needs TRUST_PROXY=true to see real addresses).
OTP_IP_MAX_PER_HOUR=30
OTP_VERIFY_IP_MAX_PER_15MIN=60
# single = one active session per account (a new sign-in ends the previous one); multiple = allow several.
SESSION_POLICY=single
SESSION_TTL_DAYS=30
SESSION_IDLE_DAYS=14

# ---- Media ----
# Private storage directory (put it on a persistent, ideally encrypted, volume). Never served statically.
STORAGE_DIR=./data/storage
MAX_IMAGE_MB=16
MAX_VIDEO_MB=64
MAX_AUDIO_MB=16
MAX_FILE_MB=32
MAX_AVATAR_MB=8
MAX_PROTECTED_MB=64
MAX_VIDEO_SECONDS=600
MAX_AUDIO_SECONDS=1800
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ---- Messaging ----
MESSAGE_EDIT_WINDOW_MINUTES=15
MESSAGE_DELETE_WINDOW_MINUTES=2880
# Unopened view-once / view-twice media is deleted after this many days.
PROTECTED_MEDIA_TTL_DAYS=14
# How long a view-once viewing session may take to download.
VIEW_SESSION_SECONDS=300
CLEANUP_INTERVAL_SECONDS=30

# ---- Web Push (optional): `npm run vapid:generate` ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Built web client served by the API server (empty = API only).
WEB_DIST_DIR=../web/dist

# ---- docker-compose only ----
DOMAIN=chat.example.com
POSTGRES_PASSWORD=change-me
