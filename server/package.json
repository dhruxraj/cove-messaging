{
  "name": "@cove/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/cli/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 --test-timeout=60000 test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "sharp": "0.35.4",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.0",
    "@types/ws": "^8.5.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
